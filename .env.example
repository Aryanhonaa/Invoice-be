NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://outinvoice:outinvoice@localhost:5432/outinvoice?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=sid
SESSION_DAYS=7
BCRYPT_ROUNDS=12

# Used by `npm run prisma:seed` (be/prisma/seed.ts). Not an HTTP endpoint.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin

# Future payment integrations — do not use until explicitly requested
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

RESEND_API_KEY=
# Production: use a verified domain, e.g. "Your Company <invoices@yourdomain.com>"
# Local testing: use onboarding@resend.dev and send only to your Resend account email
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=OutInvoice
APP_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible). Keep private — never expose to the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
